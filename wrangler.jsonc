{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framework",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Non-secret runtime settings for PRODUCTION (and any normal `wrangler deploy`). Wrangler treats this file as the source
  // of truth: a plain variable that exists only in the Cloudflare dashboard is deleted on the next deploy, so settings like
  // this one must live here (or be stored as secrets). The sender address is not a secret. Previews do not inherit this
  // block; Staging has its own copy in previews.vars below. Never put secrets (API keys, tokens, admin emails) in this file.
  "vars": {
    "ASSESSMENT_FROM": "Framework <hello@frameworkco.ca>",
    // Public Turnstile site key (safe to expose; it is rendered in the page). The matching TURNSTILE_SECRET is an
    // encrypted runtime secret stored in Cloudflare, never in this file. Both must be set for the check to be enforced.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFZzTbJqfnTzJNss"
  },
  // Keep Worker logs (console.error/warn) so a failed email shows up in the Cloudflare dashboard: Workers & Pages > framework > Logs.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // The Worker runs for the API and for the private admin area (it checks the Cloudflare Access token before
    // serving anything under /admin), and for /card so its link-preview URLs match the environment. Every other public page is
    // still served straight from static assets. The three /portal paths belong to the temporary Staging sign-in probe: on Production
    // the probe is off, so the Worker hands those requests straight back to the static site (a 404 page, as before).
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/card", "/portal/login", "/portal/auth/callback", "/portal/logout"]
  },
  // Private client feedback responses (D1). This binding is used by normal `wrangler deploy` deployments.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framework-feedback",
      "database_id": "47d90f94-3846-4711-9495-ab3479431a6f"
    }
  ],
  // Branch builds (Staging) run `wrangler preview`. A Preview does NOT inherit the top-level bindings above:
  // it only gets what is listed here, so without this block env.DB is undefined and /api/feedback answers
  // 503 "storage_not_configured". Staging has its OWN database (framework-staging) so test submissions never mix with
  // Production's framework-feedback. Same binding name (DB), so the code is identical in both. Never swap these IDs.
  "previews": {
    // Non-secret runtime settings for Previews. In Wrangler the config file is the source of truth: a plain variable
    // that exists only in the dashboard is deleted on the next deploy, and previews do not inherit top-level `vars`.
    // (Secrets such as RESEND_API_KEY are different: they live in Cloudflare and survive deploys.) The sender address
    // is not a secret, so it belongs here. Keep secrets out of this file.
    "vars": {
      "ASSESSMENT_FROM": "Framework <hello@frameworkco.ca>",
      // Public Turnstile site key (safe to expose; it is rendered in the page). The matching TURNSTILE_SECRET is an
      // encrypted secret stored in Cloudflare, never in this file. Production does not get this key from here.
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFZzTbJqfnTzJNss",
      // Client portal (Staging only). Non-secret settings must live here or the next deploy deletes them from the dashboard.
      // PORTAL_AUTH_CLIENT_ID is the public WorkOS Staging client id (not a secret; it appears in the sign-in URL).
      // Secrets stay in Cloudflare and are never written here: PORTAL_AUTH_CLIENT_SECRET (the WorkOS API key), PORTAL_SESSION_PEPPER.
      "PORTAL_AUTH_CLIENT_ID": "client_01M58C412YHC548S5JXP1TJ2ED",
      "PORTAL_BASE_URL": "https://staging.frameworkco.ca",
      // The exact token issuer, verified in the live Staging test (it embeds the client id).
      "PORTAL_AUTH_ISSUER": "https://api.workos.com/user_management/client_01M58C412YHC548S5JXP1TJ2ED",
      // Switches the Phase 0 sign-in probe on. Delete this line (and worker/portal/probe.js) when the probe is retired.
      "PORTAL_PROBE": "1"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "framework-staging",
        "database_id": "c4815cdc-8948-4561-92a3-65e4860cdb94"
      },
      {
        "binding": "PORTAL_DB",
        "database_name": "framework-portal-staging",
        "database_id": "1edda8a2-5249-4f40-9dbc-d29aa44e21f8"
      }
    ],
    // Private bucket for client files. Not served publicly (no public access, no custom domain).
    "r2_buckets": [
      {
        "binding": "PORTAL_FILES",
        "bucket_name": "framework-portal-files-staging"
      }
    ]
  }
}
