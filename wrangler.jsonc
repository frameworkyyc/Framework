{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framework",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Non-secret runtime settings for PRODUCTION (and any normal `wrangler deploy`). Wrangler treats this file as the source
  // of truth: a plain variable that exists only in the Cloudflare dashboard is deleted on the next deploy, so settings like
  // this one must live here (or be stored as secrets). The sender address is not a secret. Previews do not inherit this
  // block; Staging has its own copy in previews.vars below. Never put secrets (API keys, tokens, admin emails) in this file.
  "vars": {
    "ASSESSMENT_FROM": "Framework <hello@frameworkco.ca>",
    // Staff recipient for assessment and client-service notifications, pinned explicitly (it is also the code's default). Not a secret.
    "ASSESSMENT_NOTIFY_TO": "hello@frameworkco.ca",
    // Public Turnstile site key (safe to expose; it is rendered in the page). The matching TURNSTILE_SECRET is an
    // encrypted runtime secret stored in Cloudflare, never in this file. Both must be set for the check to be enforced.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFZzTbJqfnTzJNss",
    // Client portal, PRODUCTION settings (non-secret). INERT until the portal is switched on: it answers only when PORTAL_ENABLED is exactly "1",
    // and on the live hosts it additionally needs PORTAL_ALLOW_PRODUCTION = "1" (worker/portal/config.js). BOTH flags are deliberately absent
    // here and are added in one separate, reviewed launch change. PORTAL_AUTH_CLIENT_ID is the public WorkOS PRODUCTION client id (not Staging's).
    // PORTAL_BASE_URL must match the WorkOS redirect, logout and initiate-login URLs exactly. PORTAL_AUTH_ISSUER follows the Staging pattern
    // and is unverified until the first live Production sign-in test. Secrets stay in Cloudflare: PORTAL_AUTH_CLIENT_SECRET, PORTAL_SESSION_PEPPER.
    "PORTAL_AUTH_CLIENT_ID": "client_01M58C4236FYNJDQ3MM0E8V691",
    "PORTAL_BASE_URL": "https://frameworkco.ca",
    "PORTAL_AUTH_ISSUER": "https://api.workos.com/user_management/client_01M58C4236FYNJDQ3MM0E8V691",
    // LAUNCH (Beta 1.0): the portal is ON in Production. PORTAL_ENABLED and PORTAL_ALLOW_PRODUCTION must BOTH be exactly "1" (worker/portal/config.js).
    // Rollback: delete these four lines (a one-line revert PR) and every /portal path returns the plain 404 again.
    "PORTAL_ENABLED": "1",
    "PORTAL_ALLOW_PRODUCTION": "1",
    // Framework Admin -> Clients: create client organizations and invitations (behind Cloudflare Access AND ADMIN_EMAILS), and send invitations.
    // Sending is still limited server-side to the exact addresses in the Cloudflare secret PORTAL_INVITE_ALLOWLIST (missing or malformed = every invitation operation refused).
    "PORTAL_ADMIN_WRITES": "1",
    "PORTAL_INVITE_SENDING": "1"
  },
  // Keep Worker logs (console.error/warn) so a failed email shows up in the Cloudflare dashboard: Workers & Pages > framework > Logs.
  // redact_query_string keeps ?code= / ?invitation_token= out of platform logs; invocation_logs is OFF because the automatic per-request record
  // keeps the WorkOS Referer. Same settings as Staging, applied BEFORE the portal can ever be enabled here.
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // The Worker runs for the API and for the private admin area (it checks the Cloudflare Access token before
    // serving anything under /admin), and for /card so its link-preview URLs match the environment. Every other public page is
    // still served straight from static assets. /portal and /portal/* belong to the client portal router (worker/portal/router.js): it
    // answers only where PORTAL_ENABLED is "1" (set in previews.vars for Staging only, never at the top level, so never on Production); everywhere else the Worker returns
    // an explicit 404 for these paths. Note "/portal/*" does not match "/portal" itself, so both are listed.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/card", "/portal", "/portal/*"]
  },
  // Private client feedback responses (D1). This binding is used by normal `wrangler deploy` deployments.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framework-feedback",
      "database_id": "47d90f94-3846-4711-9495-ab3479431a6f"
    },
    {
      "binding": "PORTAL_DB",
      "database_name": "framework-portal",
      "database_id": "b213b7db-ed29-4ab6-946c-0728dd6709e8",
      // Safeguard: without this, `wrangler d1 migrations ...` on this binding would default to ./migrations, the FEEDBACK database's folder.
      // The portal's migrations live in migrations/portal (one .sql file). Nothing runs on deploy; the reviewed manual workflow applies them.
      "migrations_dir": "migrations/portal"
    }
  ],
  // Client files (PRODUCTION rollout Stage 3): two PRIVATE R2 buckets, no public access and no custom domain. PORTAL_FILES holds the files; PORTAL_FILES_BACKUP holds
  // copies (worker/portal/file-backup.js; it has a retain-everything bucket lock, and the application never deletes there). Bound here, but nothing uses them for clients until
  // PORTAL_BRANDING / PORTAL_SERVICES are switched on (Stage 4), and there is no cron yet (Stage 5). Admin -> Branding -> Storage can check, back up and restore.
  "r2_buckets": [
    { "binding": "PORTAL_FILES", "bucket_name": "framework-portal-files" },
    { "binding": "PORTAL_FILES_BACKUP", "bucket_name": "framework-portal-files-backup" }
  ],
  // Background work (PRODUCTION rollout Stage 5), every 5 minutes, Production only (Previews are never invoked by Cron Triggers): worker/portal/scheduled.js runs
  // (1) the Client Services email sweep, only while PORTAL_SERVICES is "1" (atomic claim, no duplicate emails, retries at 1/4/9/16 minutes, at most 5 attempts) and
  // (2) the client-file backup (copy-only, never deletes or overwrites a backup object). Rollback: set "crons": [].
  "triggers": { "crons": ["0-59/5 * * * *"] },
  // Portal abuse limiter (worker/portal/ratelimit.js): 20 requests / 60 s per client network on sign-in start, callback and sign-out. Inert while
  // the portal is off. namespace_id must be unique in the account: 4201 is Production's, Staging uses 4101 in previews.ratelimits.
  "ratelimits": [
    { "name": "PORTAL_RATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } }
  ],
  // Branch builds (Staging) run `wrangler preview`. A Preview does NOT inherit the top-level bindings above:
  // it only gets what is listed here, so without this block env.DB is undefined and /api/feedback answers
  // 503 "storage_not_configured". Staging has its OWN database (framework-staging) so test submissions never mix with
  // Production's framework-feedback. Same binding name (DB), so the code is identical in both. Never swap these IDs.
  "previews": {
    // Staging logging. Application logs (console.log/error, including the portal's own request events) and errors stay on.
    // redact_query_string removes query strings from request URLs in Workers Logs and traces: Staging sign-in requests carry
    // ?code= (authorization code) and possibly ?invitation_token=, which must not be retained in platform logs.
    // invocation_logs is OFF because Cloudflare's automatic per-request record keeps request headers (cookies are redacted, but not
    // Referer), and the WorkOS sign-in callback arrives with a Referer holding a WorkOS AuthKit /success?client_redirect_key=... URL.
    // Production is deliberately unchanged here; it is decided separately and must be before the portal is ever enabled there.
    "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
    // Non-secret runtime settings for Previews. In Wrangler the config file is the source of truth: a plain variable
    // that exists only in the dashboard is deleted on the next deploy, and previews do not inherit top-level `vars`.
    // (Secrets such as RESEND_API_KEY are different: they live in Cloudflare and survive deploys.) The sender address
    // is not a secret, so it belongs here. Keep secrets out of this file.
    "vars": {
      "ASSESSMENT_FROM": "Framework <hello@frameworkco.ca>",
      // Public Turnstile site key (safe to expose; it is rendered in the page). The matching TURNSTILE_SECRET is an
      // encrypted secret stored in Cloudflare, never in this file. Production does not get this key from here.
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFZzTbJqfnTzJNss",
      // Client portal (Staging only). Non-secret settings must live here or the next deploy deletes them from the dashboard.
      // PORTAL_AUTH_CLIENT_ID is the public WorkOS Staging client id (not a secret; it appears in the sign-in URL).
      // Secrets stay in Cloudflare and are never written here: PORTAL_AUTH_CLIENT_SECRET (the WorkOS API key), PORTAL_SESSION_PEPPER.
      "PORTAL_AUTH_CLIENT_ID": "client_01M58C412YHC548S5JXP1TJ2ED",
      "PORTAL_BASE_URL": "https://staging.frameworkco.ca",
      // The exact token issuer, verified in the live Staging test (it embeds the client id).
      "PORTAL_AUTH_ISSUER": "https://api.workos.com/user_management/client_01M58C412YHC548S5JXP1TJ2ED",
      // Switches the client portal on for Staging ONLY. It must never appear in the top-level vars (Production): without it every /portal path answers 404.
      "PORTAL_ENABLED": "1",
      // Serves the static, clearly labelled demo portal at /portal/demo (fictional data, no sign-in, no database). Staging ONLY: never at the top level, and the code also refuses it on the live hosts (worker/portal/config.js demoEnabled).
      "PORTAL_DEMO": "1",
      // Framework Admin -> Clients invitation workflow, STAGING ONLY (never at the top level, so never on Production). Both are exactly "1" or absent.
      //   PORTAL_ADMIN_WRITES  : lets the admin (behind Cloudflare Access AND the ADMIN_EMAILS list) create client organizations and invitations, change roles and remove access.
      //   PORTAL_INVITE_SENDING: additionally lets the admin SEND invitations (WorkOS invitation email, or Framework's own email through Resend for someone who already has a sign-in).
      // Sending is still limited server-side to the EXACT addresses in the Cloudflare secret PORTAL_INVITE_ALLOWLIST (this repository is public, so the addresses are not here).
      // Missing, empty or malformed means every invitation operation is refused. Setup and the add-an-address procedure: worker/portal/INVITATION-DELIVERY-PLAN.md and ADMIN-INVITATIONS-RUNBOOK.md.
      "PORTAL_ADMIN_WRITES": "1",
      "PORTAL_INVITE_SENDING": "1",
      // Turns on the client-facing Branding section (view and download published brand assets, upload existing brand materials). STAGING ONLY, never at the top level.
      // Needs migrations 0005/0006 and the PORTAL_FILES binding below. Exactly "1" or absent: absent keeps Branding as a "Coming soon" page.
      "PORTAL_BRANDING": "1",
      // Turns on the client-facing Client Services area (invoices, support & change requests, contact). STAGING ONLY, never at the top level. Needs migration 0007 for its data.
      "PORTAL_SERVICES": "1"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "framework-staging",
        "database_id": "c4815cdc-8948-4561-92a3-65e4860cdb94"
      },
      {
        "binding": "PORTAL_DB",
        "database_name": "framework-portal-staging",
        "database_id": "1edda8a2-5249-4f40-9dbc-d29aa44e21f8",
        "migrations_dir": "migrations/portal"
      }
    ],
    // Private bucket for client files. Not served publicly (no public access, no custom domain).
    "r2_buckets": [
      {
        "binding": "PORTAL_FILES",
        "bucket_name": "framework-portal-files-staging"
      },
      // A second private bucket for copies of the files (worker/portal/file-backup.js). Staging has no cron, so here it is exercised from Admin -> Branding -> Storage
      // ("Run backup check", "Back up now", "Restore missing files"). Production gets its own pair in the Production rollout (Stage 3).
      {
        "binding": "PORTAL_FILES_BACKUP",
        "bucket_name": "framework-portal-files-staging-backup"
      }
    ],
    // Application-level abuse limiter for the portal's unauthenticated endpoints (worker/portal/ratelimit.js): sign-in start, callback and
    // sign-out, counted per client network (IPv4 address or IPv6 /64) and bucket, 20 requests per 60 seconds. Staging only: it must never appear
    // at the top level (Production). It complements, and does not replace, the Cloudflare WAF rate-limiting rule. If the binding is missing the
    // portal simply does not limit (fails open). namespace_id must be unique in the account (equal ids share counters): use a different one for Production later.
    "ratelimits": [
      { "name": "PORTAL_RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } }
    ]
  }
}
