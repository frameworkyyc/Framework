# Private client feedback page: keep out of search engines and caches, don't leak the URL via Referer.
/client-feedback
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/client-feedback.html
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# Assessment landing page and privacy notice: no framing, no MIME sniffing.
/assessment
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
/assessment.html
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
/privacy.html
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Personal quick-access page: keep out of search engines and caches, don't leak the URL via Referer.
/me
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-cache
  X-Frame-Options: DENY
/me.html
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-cache
  X-Frame-Options: DENY
